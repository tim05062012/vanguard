// Ресурсы VANGUARD.exe: манифест (requireAdministrator для PresentMon),
// иконка приложения и версия.
#include <windows.h>

IDI_APPICON ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VANGUARD"
            VALUE "FileDescription", "VANGUARD Game Launcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "VANGUARD"
            VALUE "LegalCopyright", "(c) 2026 VANGUARD"
            VALUE "OriginalFilename", "VANGUARD.exe"
            VALUE "ProductName", "VANGUARD"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
